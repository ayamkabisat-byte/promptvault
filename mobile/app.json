{
  "expo": {
    "name": "PromptVault",
    "slug": "promptvault-mobile",
    "version": "0.1.3",
    "orientation": "portrait",
    "scheme": "promptvault",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "barStyle": "light",
          "enforceContrast": false
        }
      ]
    ],
    "android": {
      "package": "com.ayamkabisat.promptvault",
      "versionCode": 3
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
